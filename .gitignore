# compiled binary — build-app.sh regenerates it at any time
sprint-board
.DS_Store

# local tool output — so another developer's `git add -A` cannot
# sweep it into the repo by accident
.claude/
.orbit-output/

# distribution output — regenerated by the build
dist/

# wrangler cache — holds an account name/ID, must never be committed
worker/.wrangler/
