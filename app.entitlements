<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- After a Hosts switch the app asks Google Chrome, through Apple Events, to drop its open
       connections. Under the hardened runtime macOS refuses that without this entitlement
       (error -1743) and never shows the permission prompt. -->
  <key>com.apple.security.automation.apple-events</key><true/>
</dict>
</plist>
